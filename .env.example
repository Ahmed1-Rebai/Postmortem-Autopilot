# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- LLM ---
LLM_PROVIDER=openrouter             # anthropic | openrouter | mock

# provider=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# ANALYST_MODEL=claude-sonnet-5
# WRITER_MODEL=claude-sonnet-5

# provider=openrouter — OpenAI-compatible gateway, has a free tier.
# Models with a `:free` suffix cost nothing; most are reasoning models, so
# reasoning_tokens eat into max_tokens and drafts truncate if it's set low.
OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ANALYST_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
WRITER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme-local-only

# --- Valkey ---
VALKEY_URL=redis://localhost:6379/0

# --- Pipeline tuning ---
CAUSAL_WINDOW_MINUTES=15
CITATION_COVERAGE_THRESHOLD=0.95
MAX_VALIDATION_RETRIES=2
MAX_EVENTS_PER_RUN=5000

# --- Confidence model weights (see docs/03-confidence-model.md) ---
CONFIDENCE_CONFIG_PATH=./config/confidence.yaml

# --- Collector sources (Phase 1: local fixtures) ---
LOG_SOURCE_PATH=./evals/fixtures/logs
GIT_REPO_PATH=./evals/fixtures/repo
ALERTS_FIXTURE=./evals/fixtures/alerts.json

# --- Output ---
OUTPUT_DIR=./out
