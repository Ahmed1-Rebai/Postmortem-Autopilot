# --- secrets & local config ---
.env

# --- run artifacts ---
out/

# Timestamped per-run reports are regenerated noise; history.jsonl is the
# one file docs/07-evaluation.md wants committed, so metric trends over
# time are plottable (and diffable in review, unlike the per-run JSON).
evals/results/*
!evals/results/history.jsonl

# Generated git fixtures. A nested .git inside a tracked directory becomes a
# broken gitlink; rebuild with each incident's build_repo.py.
evals/incidents/*/repo/

# --- python ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- editors / OS ---
.vscode/
.idea/
.DS_Store

CLAUDE.md